<?xml version="1.0" encoding="UTF-8"?>
<meta>
    <info name="mta-dx-ui" version="3.0.0" type="script"
        description="DXUI V3 — production МТА:SA UI engine (DX9, Lua 5.1)" />

    <!-- ============================================================
         DXUI V3 manifest. Script order is the dependency order:
         core → text → style → animation → resources → layout →
         render → input → api → widgets → glue (init).
         Every script shares the client global environment; `init.lua`
         MUST be last (composes DXUI + wires MTA input).
         ============================================================ -->

    <!-- settings -->
    <script src="source/client/settings.lua" />

    <!-- core -->
    <script src="source/client/core/values.lua" />
    <script src="source/client/core/node.lua" />
    <script src="source/client/core/widget.lua" />
    <script src="source/client/core/part.lua" />

    <!-- text & translation -->
    <script src="source/client/translation.lua" />
    <script src="source/client/text/text.lua" />

    <!-- style (theme) -->
    <script src="source/client/style/tokens.lua" />
    <script src="source/client/style/theme.lua" />
    <script src="source/client/style/defaults.lua" />

    <!-- animation -->
    <script src="source/client/animation/easing.lua" />
    <script src="source/client/animation/animation.lua" />

    <!-- resources -->
    <script src="source/client/resources/manager.lua" />

    <!-- layout -->
    <script src="source/client/layout/dimension.lua" />
    <script src="source/client/layout/flex.lua" />
    <script src="source/client/layout/layout.lua" />

    <!-- render -->
    <script src="source/client/render/render_list.lua" />
    <script src="source/client/render/effects.lua" />
    <script src="source/client/render/backend_mta.lua" />
    <script src="source/client/render/renderer.lua" />
    <script src="source/client/render/state.lua" />
    <script src="source/client/render/pass.lua" />

    <!-- input -->
    <script src="source/client/input/events.lua" />
    <script src="source/client/input/hit_test.lua" />
    <script src="source/client/input/dispatcher.lua" />

    <!-- api -->
    <script src="source/client/api/runtime.lua" />
    <script src="source/client/api/ui.lua" />
    <script src="source/client/api/exports.lua" />
    <script src="source/client/api/diagnostics.lua" />

    <!-- widgets (basic) -->
    <script src="source/client/widgets/builders.lua" />
    <script src="source/client/widgets/panel.lua" />
    <script src="source/client/widgets/label.lua" />
    <script src="source/client/widgets/button.lua" />
    <script src="source/client/widgets/image.lua" />
    <script src="source/client/widgets/window.lua" />

    <!-- widgets (composite) -->
    <script src="source/client/widgets/checkbox.lua" />
    <script src="source/client/widgets/radiobutton.lua" />
    <script src="source/client/widgets/progressbar.lua" />
    <script src="source/client/widgets/slider.lua" />
    <script src="source/client/widgets/scrollpanel.lua" />
    <script src="source/client/widgets/edit.lua" />
    <script src="source/client/widgets/combobox.lua" />
    <script src="source/client/widgets/tabpanel.lua" />
    <script src="source/client/widgets/gridlist.lua" />
    <script src="source/client/widgets/popup.lua" />
    <script src="source/client/widgets/contextmenu.lua" />
    <script src="source/client/widgets/modal.lua" />
    <script src="source/client/widgets/tooltip.lua" />

    <!-- MTA glue (LAST) -->
    <script src="source/client/init.lua" />

